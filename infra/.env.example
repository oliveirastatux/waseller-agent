# ══════════════════════════════════════════════════════
# GO.IA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ══════════════════════════════════════════════════════

# ── POSTGRES ───────────────────────────────────────────
POSTGRES_PASSWORD=troque_por_senha_forte_aqui

# ── REDIS ──────────────────────────────────────────────
REDIS_PASSWORD=troque_por_outra_senha_forte

# ── EVOLUTION API (WhatsApp) ───────────────────────────
# URL pública do seu servidor (com https se tiver domínio)
EVOLUTION_URL=http://localhost:8080
# Chave de admin — crie qualquer string longa e aleatória
EVOLUTION_API_KEY=goian_evolution_chave_secreta_aqui

# ── N8N ────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=troque_por_senha_forte_n8n
N8N_HOST=localhost

# ── SUPABASE ───────────────────────────────────────────
# JWT Secret — string aleatória com pelo menos 32 caracteres
JWT_SECRET=troque_por_string_aleatoria_longa_aqui_32chars
# Anon key e service key — geradas com o JWT_SECRET
# Use: https://supabase.com/docs/guides/self-hosting#api-keys
SUPABASE_ANON_KEY=gere_aqui
SUPABASE_SERVICE_KEY=gere_aqui
